{
  "$schema": "https://opencode.ai/config.json",
  "default_agent": "framework-coordinator",
  "experimental": { "subagent_depth": 1 },
  "mcp": {
    "servers": {
      "hcc-patternfly-data-view": {
        "type": "local",
        "command": ["hcc-pf-mcp"]
      },
      "chrome-devtools": {
        "type": "local",
        "command": [
          "chrome-devtools-mcp",
          "--browserUrl",
          "http://127.0.0.1:9222",
          "--acceptInsecureCerts"
        ]
      }
    }
  }
}
